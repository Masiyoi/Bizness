// TikTok Events API (server-side). Mirrors services/metaCapi.js.
const crypto = require('crypto');
const ENDPOINT = 'https://business-api.tiktok.com/open_api/v1.3/event/track/';
const sha256 = (v) => crypto.createHash('sha256').update(String(v)).digest('hex');
const hashEmail = (e) => (e ? sha256(String(e).trim().toLowerCase()) : undefined);
// Kenyan numbers -> E.164 (+254...), then hash
function hashPhone(p) {
  if (!p) return undefined;
  let d = String(p).replace(/\D/g, '');
  if (!d) return undefined;
  if (d.startsWith('0')) d = '254' + d.slice(1);
  else if (d.length === 9) d = '254' + d;
  return sha256('+' + d);
}
/**
 * sendTikTokEvent({
 *   event: 'Purchase',            // ViewContent | AddToCart | InitiateCheckout | AddPaymentInfo | PlaceAnOrder | Purchase | CompleteRegistration ...
 *   eventId,                      // same id the browser pixel uses, for dedup
 *   url, referrer,
 *   user: { email, phone, externalId, ip, userAgent, ttclid, ttp },
 *   contents: [{ content_id, content_name, quantity, price }],
 *   value, currency
 * })
 */
async function sendTikTokEvent(opts) {
  try {
    const pixelId = process.env.TIKTOK_PIXEL_ID;
    const token = process.env.TIKTOK_ACCESS_TOKEN;
    if (!pixelId || !token) return;
    const { event, eventId, url, referrer, user = {}, contents = [], value, currency = 'KES' } = opts;
    const body = {
      event_source: 'web',
      event_source_id: pixelId,
      data: [
        {
          event,
          event_time: Math.floor(Date.now() / 1000),
          event_id: eventId,
          user: {
            email: hashEmail(user.email),
            phone: hashPhone(user.phone),
            external_id: user.externalId ? sha256(user.externalId) : undefined,
            ip: user.ip,
            user_agent: user.userAgent,
            ttclid: user.ttclid,
            ttp: user.ttp,
          },
          properties: {
            currency,
            value,
            content_type: 'product',
            contents: contents.map((c) => ({
              content_id: String(c.content_id),
              content_type: 'product',
              content_name: c.content_name,
              quantity: c.quantity,
              price: c.price,
            })),
          },
          page: { url, referrer },
        },
      ],
    };
    if (process.env.TIKTOK_TEST_EVENT_CODE) body.test_event_code = process.env.TIKTOK_TEST_EVENT_CODE;
    const res = await fetch(ENDPOINT, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Access-Token': token },
      body: JSON.stringify(body),
      signal: AbortSignal.timeout(5000),
    });
    const json = await res.json().catch(() => ({}));
    if (json.code !== 0) console.warn('[tiktok] event rejected:', event, json.code, json.message);
  } catch (err) {
    console.warn('[tiktok] send failed:', err.message);
  }
}
module.exports = { sendTikTokEvent };